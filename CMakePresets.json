{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
      
        {
            "name": "msvc",
            "displayName": "MSVC x64",
            "description": "使用 Visual Studio 2026、MSBuild 和 vcpkg",
            "generator": "Visual Studio 18 2026",
            "binaryDir": "${sourceDir}/build/msvc",
            "architecture": "x64",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/bin/$<CONFIG>"
            }
        }
    ],
    "buildPresets": [
    
        {
            "name": "msvc-debug",
            "displayName": "Build MSVC Debug",
            "configurePreset": "msvc",
            "configuration": "Debug"
        },
        {
            "name": "msvc-release",
            "displayName": "Build MSVC Release",
            "configurePreset": "msvc",
            "configuration": "Release"
        },
        {
            "name": "msvc-relwithdebinfo",
            "displayName": "Build MSVC RelWithDebInfo",
            "configurePreset": "msvc",
            "configuration": "RelWithDebInfo"
        }
    ]
}